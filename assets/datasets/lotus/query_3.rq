# Retrieve organisms in which a compound identified by its InChIKey has been reported.

PREFIX lotus: <http://purl.jp/bio/lotus/ontology/>
PREFIX schema: <https://schema.org/>
PREFIX dwc: <http://rs.tdwg.org/dwc/terms/>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX bibo: <http://purl.org/ontology/bibo/>

SELECT DISTINCT
  ?compound ?organism ?scientific_name ?reference ?doi
WHERE {
  # Example InChIKey from the supplied RDF
  VALUES ?inchikey { "NMKSAYKQLCHXDK-UHFFFAOYSA-N" }

  ?compound a schema:MolecularEntity ;
            schema:inChIKey ?inchikey .

  ?occurrence a lotus:Occurrence ;
              lotus:structure ?compound ;
              lotus:organism ?organism ;
              dct:references ?reference .

  OPTIONAL { ?organism dwc:scientificName ?scientific_name . }
  OPTIONAL { ?reference bibo:doi ?doi . }
}
ORDER BY ?scientific_name ?reference
LIMIT 100

